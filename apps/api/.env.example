# Database Configuration
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres

# Application Configuration
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:4001,http://localhost:4002

# Better Auth Configuration
BETTER_AUTH_SECRET=your-secret-key-here-min-32-chars-long-for-security
BETTER_AUTH_URL=http://localhost:4000

# Microsoft OAuth (optional - for SSO)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Email Configuration (optional - for password reset emails)
# Sign up for free at https://resend.com to get an API key
# Without these, password reset links will be logged to console
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# Notification jobs (ASH-86). POST /api/jobs/notifications with X-Cron-Secret.
# Reminder is 48h = 2 UTC calendar days before a date-only due date.
# Monthly summary sends on UTC day 1: completed last month / due this month.
# Staff digest is weekly (UTC weekday, 0=Sun … 6=Sat). Default Monday.
# In-app scholar-list badge/filter is the daily coordinator surface.
# last_activity null means unknown, not "never logged in" (the column was unused before ASH-86).
CRON_SECRET=dev-cron-secret
NOTIFICATION_REMINDER_DAYS=2
NOTIFICATION_INACTIVITY_DAYS=14
NOTIFICATION_MONTHLY_DAY=1
NOTIFICATION_ACTIVITY_TOUCH_HOURS=6
NOTIFICATION_STAFF_DIGEST_WEEKDAY=1

# Frontend URLs
STAFF_APP_URL=http://localhost:4001
SCHOLAR_APP_URL=http://localhost:4002

# S3 Configuration (for file uploads)
# For local development, you can use the test environment bucket
# Make sure you have AWS credentials configured locally
# In production, these are set via environment variables
S3_BUCKET_NAME=ashinaga-scholar-data-test
AWS_REGION=eu-west-3