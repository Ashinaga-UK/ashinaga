{
  "name": "ashinaga",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev storybook --parallel",
    "dev:db": "docker compose up -d postgres",
    "dev:down": "docker compose down",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:integration": "cd apps/api && pnpm test:integration",
    "test:e2e": "turbo run test:e2e",
    "test:coverage": "turbo run test:coverage",
    "test:coverage:open": "turbo run test:coverage:open",
    "lint": "pnpm check:skills && pnpm check:migrations && pnpm test:migrations && pnpm test:flow-coverage && turbo run check",
    "check:skills": "node ./scripts/check-skill-packages.mjs",
    "check:migrations": "node ./scripts/check-migration-journal.mjs",
    "test:migrations": "node --test ./scripts/check-migration-journal.test.mjs",
    "check:flow-coverage": "node ./scripts/check-flow-coverage.mjs",
    "test:flow-coverage": "node --test ./scripts/check-flow-coverage.test.mjs",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "db:generate": "cd apps/api && pnpm db:generate",
    "db:migrate": "cd apps/api && pnpm db:migrate",
    "db:studio": "cd apps/api && pnpm db:studio"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.6",
    "@workspace/typescript-config": "workspace:*",
    "turbo": "^2.11.10"
  },
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=20.19"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "^1.1.20",
      "brace-expansion@2": "^2.1.6",
      "browserslist": "^4.28.7",
      "fast-uri": "^3.1.7",
      "fastify": "^5.12.5",
      "flatted": "^3.4.2",
      "form-data": "^4.0.6",
      "glob@10": "^10.5.0",
      "js-yaml@3": "^3.15.2",
      "js-yaml@4": "^4.3.2",
      "minimatch@3": "^3.1.4",
      "minimatch@9": "^9.0.7",
      "@nestjs/platform-express": "^11.2.7",
      "picomatch@2": "^2.3.2",
      "picomatch@4": "^4.0.4",
      "postcss": "^8.5.32",
      "rollup": "^4.59.0",
      "source-map-js": "^1.2.2",
      "tmp": "^0.2.6",
      "vite": "^7.3.7",
      "ws": "^8.21.0"
    }
  }
}
