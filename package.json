{
  "name": "ashinaga",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev storybook --parallel",
    "dev:db": "docker compose up -d postgres",
    "dev:down": "docker compose down",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:integration": "cd apps/api && pnpm test:integration",
    "test:e2e": "pnpm --filter ashinaga-api run dev > /tmp/ashinaga-api.log 2>&1 & NEXT_PUBLIC_API_URL=http://127.0.0.1:4000 pnpm --filter staff run dev > /tmp/ashinaga-staff.log 2>&1 & sleep 12 && curl -s http://127.0.0.1:4001 > /dev/null && sleep 3 && turbo run test:e2e; kill $(lsof -ti :4000 -ti :4001) 2>/dev/null",
    "test:coverage": "turbo run test:coverage",
    "test:coverage:open": "turbo run test:coverage:open",
    "lint": "pnpm check:skills && turbo run check",
    "check:skills": "node ./scripts/check-skill-packages.mjs",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "db:generate": "cd apps/api && pnpm db:generate",
    "db:migrate": "cd apps/api && pnpm db:migrate",
    "db:studio": "cd apps/api && pnpm db:studio"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.6",
    "@workspace/typescript-config": "workspace:*",
    "turbo": "^2.5.4"
  },
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=18"
  }
}
