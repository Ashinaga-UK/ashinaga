# Copy to .env.local (never commit real credentials).
# Placeholders only.

# Target: "test" (default) or "local". Prod is refused.
QA_TARGET=test

# Optional URL overrides (defaults: test = *-test.ashinaga-uk.org, local = localhost:4000/4001/4002)
# API_URL=
# STAFF_APP_URL=
# SCHOLAR_APP_URL=

# Staff account with super-admin access on the target
QA_STAFF_EMAIL=qa-staff@example.org
QA_STAFF_PASSWORD=change-me

# Prep Year candidate (program_stage = prep_year)
QA_PREP_EMAIL=qa-prep@example.org
QA_PREP_PASSWORD=change-me

# Enrolled scholar (program_stage = scholar)
QA_SCHOLAR_EMAIL=qa-scholar@example.org
QA_SCHOLAR_PASSWORD=change-me

# Optional fixtures
# QA_SCHOLAR_ID=        # scholar id for staff profile flows (else looked up via the API)
# QA_INVITE_TOKEN=      # pending scholar invitation token for student.signup-from-invite

# Local seeding only (seed-local refuses non-localhost databases)
# DB_HOST=localhost
# DB_PORT=5433
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=postgres
