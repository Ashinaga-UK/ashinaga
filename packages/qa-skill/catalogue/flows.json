{
  "version": 1,
  "description": "Full staff + student flow catalogue (ASH-122). One list shared by the on-demand QA skill and the flow-coverage detector (ASH-123). Flow IDs are stable: rename only with a matching update to every consumer.",
  "personas": {
    "anonymous": "No session.",
    "staff": "Active staff with is_super_admin = true (sees every section, including Invitations management).",
    "prep": "Student with program_stage = 'prep_year' (Prep Year candidate).",
    "scholar": "Student with program_stage = 'scholar' (enrolled scholar)."
  },
  "stepTypes": {
    "goto": "Open a path on the flow's app. {scholarId} and {inviteToken} are resolved at run time.",
    "see": "Text is visible (substring match).",
    "seeRole": "An element with this ARIA role and accessible name is visible.",
    "notSeeLink": "No link with this accessible name exists (nav items that must be hidden).",
    "click": "Click the element with this ARIA role and accessible name.",
    "clickText": "Click the first element containing this text.",
    "press": "Press a keyboard key.",
    "urlIncludes": "The current URL contains this string.",
    "download": "Clicking role+name starts a file download.",
    "print": "Clicking role+name calls window.print() (stubbed, nothing is printed).",
    "write": "true on any step that creates or changes data. The runner never performs write steps: it runs the read steps and reports the flow as Skip listing the write steps. An agent walks them by hand only when the person running QA allows writes on that environment.",
    "note": "Extra instructions for a human or agent walking the step.",
    "tabSelected": "A tab with this accessible name is the selected tab."
  },
  "personaRules": {
    "either": "Both-stage student flow: runs as both prep and scholar. If either student session is missing the row is Skip, never Pass. The row fails if either run fails."
  },
